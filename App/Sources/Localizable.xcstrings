      "shouldTranslate" : false
    },
    "%@ is deleted on every device. This can’t be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の記録は、すべての端末から削除されます。元に戻すことはできません。"
          }
        }
      }
    },
    "%@ – now" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – 現在"
          }
        }
      }
    },
