    "Add what you work on, then start its timer. Your tasks are kept on this device; set up Sync to see them on your other devices too." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り組むことを追加して、タイマーを開始しましょう。タスクはこの端末に保存されます。ほかの端末でも使うには、同期を設定してください。"
          }
        }
      }
    },
    "Another tag already has this name." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
