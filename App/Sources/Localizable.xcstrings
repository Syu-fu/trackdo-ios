    "A token is saved. Leave this empty to keep it, or enter a new one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンは保存済みです。そのまま使う場合は空欄のままにし、変える場合は新しいトークンを入力してください。"
